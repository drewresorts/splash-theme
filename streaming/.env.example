# Copy this file to .env and fill it in (see README.md).

# The addresses you point at this server (DNS "A" records).
WALL_DOMAIN=wall.yourdomain.com
STREAM_DOMAIN=live.yourdomain.com

# Your store's addresses, comma-separated: only these may send changes to the wall.
WALL_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://your-store.myshopify.com

# Staff password for https://wall.yourdomain.com/admin (lock / unlock / reset).
WALL_ADMIN_PASSWORD=pick-a-long-password

# When visitors may change the wall, in the shop's time zone. Leave empty for always.
WALL_OPEN_HOURS=tue-sat 11:00-19:00, sun 12:00-17:00
WALL_TIMEZONE=America/New_York

# One change per visitor every this many seconds; changes wear off after this many minutes.
WALL_COOLDOWN_SECONDS=20
WALL_CHANGE_MINUTES=4

# Live streaming (MediaMTX): the name and password OBS uses to publish.
PUBLISH_USER=publisher
PUBLISH_PASS=pick-another-long-password
