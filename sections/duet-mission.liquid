{%- comment -%}
  About page: the brand's mission, then a row of short "pillars" (what we
  stock, how we choose it, how shopping with us feels), with photos and
  videos among them where wanted (snippets/duet-media.liquid). Styles live in
  assets/component-duet-about.css, shared with the other About sections.
{%- endcomment -%}
{{ 'component-duet-about.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="duet-about gradient section-{{ section.id }}-padding" aria-labelledby="DuetMission-{{ section.id }}">
  <div class="duet-about__inner">
    <div class="duet-about__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="duet-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- assign tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ tag }} id="DuetMission-{{ section.id }}" class="duet-about__title">{{ section.settings.heading | escape }}</{{ tag }}>
      {%- if section.settings.text != blank -%}
        <div class="duet-about__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="duet-about__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' or block.type == 'video' -%}
            <li class="duet-about__cell--{{ block.settings.width | default: 'full' }}" {{ block.shopify_attributes }}>
              {%- render 'duet-media', block: block -%}
            </li>
          {%- else -%}
            <li class="duet-about__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="duet-about__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="duet-about__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand mission",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "About Duet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our mission"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "Page title (H1)" },
        { "value": "h2", "label": "Section heading (H2)" }
      ],
      "default": "h2",
      "info": "Use Page title when this is the first section on the page."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Mission",
      "default": "<p>Duet exists to make owning luxury feel certain. We bring together pieces worth keeping, check every one of them before it reaches you, and stand behind each sale with a guarantee no one else offers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pillar"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe one thing customers can count on.</p>"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "full",
          "options": [
            { "value": "full", "label": "Whole row, nearly edge to edge" },
            { "value": "half", "label": "Half the row" },
            { "value": "column", "label": "One column" }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "natural",
          "options": [
            { "value": "natural", "label": "As the photo is" },
            { "value": "16_9", "label": "Wide (16:9)" },
            { "value": "4_3", "label": "Landscape (4:3)" },
            { "value": "1_1", "label": "Square" },
            { "value": "3_4", "label": "Portrait (3:4)" }
          ]
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video file" },
        { "type": "video_url", "id": "video_url", "label": "Or a YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "checkbox", "id": "autoplay", "label": "Play on its own", "default": true, "info": "Muted and looping, like a moving photo. Off: it waits with its play button." },
        { "type": "text", "id": "caption", "label": "Caption" },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "full",
          "options": [
            { "value": "full", "label": "Whole row, nearly edge to edge" },
            { "value": "half", "label": "Half the row" },
            { "value": "column", "label": "One column" }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "16_9",
          "options": [
            { "value": "natural", "label": "As the video is (uploaded files)" },
            { "value": "16_9", "label": "Wide (16:9)" },
            { "value": "4_3", "label": "Landscape (4:3)" },
            { "value": "1_1", "label": "Square" },
            { "value": "3_4", "label": "Portrait (3:4)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand mission",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Selection",
            "text": "<p>A tightly edited inventory: the houses, pieces and conditions we would buy ourselves, chosen for craft and lasting value rather than volume.</p>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Certainty",
            "text": "<p>Every item is reviewed for authenticity before it is listed, and every sale is backed by our authenticity guarantee.</p>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Experience",
            "text": "<p>Online or in our store, shopping with Duet should feel personal, unhurried and honest, from the first look to long after the piece is yours.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
