{%- comment -%}
  About page: how Duet checks every item, the authenticity guarantee, and
  the independent authenticators Duet endorses for verifying a purchase.

  Blocks:
  - step: one stage of the review / claim process (numbered in order)
  - authenticator: an endorsed authentication service. Blocks left without
    a name are hidden on the live store (the editor shows a reminder).
  - photo, video: pictures among the steps (snippets/duet-media.liquid);
    the steps' numbers skip over them.
  Styles: assets/component-duet-about.css.
{%- endcomment -%}
{{ 'component-duet-about.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign steps = section.blocks | where: 'type', 'step'
  assign pictures = section.blocks | where: 'type', 'photo'
  assign videos = section.blocks | where: 'type', 'video'
  assign step_row = steps.size | plus: pictures.size | plus: videos.size
  assign step_no = 0
  assign authenticators = section.blocks | where: 'type', 'authenticator'
  assign named = 0
  for a in authenticators
    if a.settings.name != blank
      assign named = named | plus: 1
    endif
  endfor
-%}

<section class="duet-about gradient section-{{ section.id }}-padding" id="authenticity" aria-labelledby="DuetAuthenticity-{{ section.id }}">
  <div class="duet-about__inner">
    <div class="duet-about__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="duet-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="DuetAuthenticity-{{ section.id }}" class="duet-about__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="duet-about__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.promise_title != blank or section.settings.promise_text != blank -%}
      <div class="duet-about__promise">
        {%- if section.settings.promise_title != blank -%}
          <p class="duet-about__promise-title">{{ section.settings.promise_title | escape }}</p>
        {%- endif -%}
        {%- if section.settings.promise_text != blank -%}
          <div class="duet-about__text">{{ section.settings.promise_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if step_row > 0 -%}
      {%- if section.settings.steps_heading != blank -%}
        <h3 class="duet-about__subhead">{{ section.settings.steps_heading | escape }}</h3>
      {%- endif -%}
      <ol class="duet-about__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' or block.type == 'video' -%}
            <li class="duet-about__cell--{{ block.settings.width | default: 'full' }}" {{ block.shopify_attributes }}>
              {%- render 'duet-media', block: block -%}
            </li>
          {%- elsif block.type == 'step' -%}
            {%- assign step_no = step_no | plus: 1 -%}
            <li class="duet-about__item" {{ block.shopify_attributes }}>
              <span class="duet-about__num" aria-hidden="true">{{ step_no | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="duet-about__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if named > 0 or request.design_mode and authenticators.size > 0 -%}
      {%- if section.settings.authenticators_heading != blank -%}
        <h3 class="duet-about__subhead">{{ section.settings.authenticators_heading | escape }}</h3>
      {%- endif -%}
      {%- if section.settings.authenticators_text != blank -%}
        <div class="duet-about__text duet-about__fine">{{ section.settings.authenticators_text }}</div>
      {%- endif -%}
      <ul class="duet-about__grid">
        {%- for block in authenticators -%}
          {%- if block.settings.name != blank -%}
            <li class="duet-about__item duet-about__authenticator" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag: class: 'duet-about__authenticator-logo', loading: 'lazy', alt: block.settings.name, widths: '140, 280, 400'
                }}
              {%- endif -%}
              <h3>
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" target="_blank" rel="noopener">{{ block.settings.name | escape }}</a>
                {%- else -%}
                  {{ block.settings.name | escape }}
                {%- endif -%}
              </h3>
              {%- if block.settings.text != blank -%}
                <div class="duet-about__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- elsif request.design_mode -%}
            <li class="duet-about__item" {{ block.shopify_attributes }}>
              <p class="duet-about__placeholder">
                Add this authenticator's name in the block settings. Unnamed blocks don't show on the live store.
              </p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.fine_print != blank -%}
      <div class="duet-about__text duet-about__fine">{{ section.settings.fine_print }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="duet-about__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Authenticity guarantee",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Authenticity"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every item, reviewed"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Every piece we offer is reviewed for authenticity before it is listed. We don't ask you to take our word for it: you are welcome to have any purchase checked by an independent authenticator we endorse.</p>"
    },
    {
      "type": "header",
      "content": "The guarantee"
    },
    {
      "type": "text",
      "id": "promise_title",
      "label": "Guarantee headline",
      "default": "Your money back, plus the price of the item again"
    },
    {
      "type": "richtext",
      "id": "promise_text",
      "label": "Guarantee",
      "default": "<p>If an authenticator Duet endorses finds that an item you bought from us is not authentic, we refund the full price you paid, and pay you the item's price again on top, for your inconvenience and the cost of having it verified.</p>"
    },
    {
      "type": "header",
      "content": "Steps"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Steps heading",
      "default": "How it works"
    },
    {
      "type": "header",
      "content": "Endorsed authenticators"
    },
    {
      "type": "text",
      "id": "authenticators_heading",
      "label": "Heading",
      "default": "Authenticators we endorse"
    },
    {
      "type": "richtext",
      "id": "authenticators_text",
      "label": "Introduction",
      "default": "<p>These independent services are recognized authorities on luxury goods. A written report from any of them is all you need to make a claim.</p>"
    },
    {
      "type": "header",
      "content": "Fine print"
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Terms",
      "default": "<p>To make a claim, contact us with your order number and the authenticator's written report.</p>",
      "info": "Add the terms of the guarantee here, such as how long after purchase a claim can be made and what happens to the item."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Make a claim"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Where customers start a claim, e.g. your contact page."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "authenticator",
      "name": "Authenticator",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "info": "What they authenticate, or how to request a review."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Website"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "full",
          "options": [
            { "value": "full", "label": "Whole row, nearly edge to edge" },
            { "value": "half", "label": "Half the row" },
            { "value": "column", "label": "One column" }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "natural",
          "options": [
            { "value": "natural", "label": "As the photo is" },
            { "value": "16_9", "label": "Wide (16:9)" },
            { "value": "4_3", "label": "Landscape (4:3)" },
            { "value": "1_1", "label": "Square" },
            { "value": "3_4", "label": "Portrait (3:4)" }
          ]
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video file" },
        { "type": "video_url", "id": "video_url", "label": "Or a YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "checkbox", "id": "autoplay", "label": "Play on its own", "default": true, "info": "Muted and looping, like a moving photo. Off: it waits with its play button." },
        { "type": "text", "id": "caption", "label": "Caption" },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "full",
          "options": [
            { "value": "full", "label": "Whole row, nearly edge to edge" },
            { "value": "half", "label": "Half the row" },
            { "value": "column", "label": "One column" }
          ]
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Shape",
          "default": "16_9",
          "options": [
            { "value": "natural", "label": "As the video is (uploaded files)" },
            { "value": "16_9", "label": "Wide (16:9)" },
            { "value": "4_3", "label": "Landscape (4:3)" },
            { "value": "1_1", "label": "Square" },
            { "value": "3_4", "label": "Portrait (3:4)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Authenticity guarantee",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Reviewed before it's listed",
            "text": "<p>Our team inspects every item for authenticity and condition before it goes on sale.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Verify it yourself",
            "text": "<p>Want a second opinion? Have your purchase reviewed by any authenticator we endorse.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Send us the report",
            "text": "<p>If their report finds the item is not authentic, send it to us with your order number.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Paid back, and then some",
            "text": "<p>We refund the full price you paid and pay you the item's price again on top.</p>"
          }
        },
        {
          "type": "authenticator"
        },
        {
          "type": "authenticator"
        },
        {
          "type": "authenticator"
        }
      ]
    }
  ]
}
{% endschema %}
