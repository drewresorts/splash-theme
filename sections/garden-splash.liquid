{%- liquid
  assign logo_image = section.settings.logo | default: settings.splash_streams_logo
  assign garden_menu = section.settings.menu
  assign logo_position = section.settings.logo_position | default: 'top'
  assign logo_width = section.settings.logo_width | default: 120
  assign menu_style = section.settings.menu_style | default: 'outline'
  assign menu_label = section.settings.menu_label | default: 'Menu'
  assign menu_close_label = section.settings.menu_close_label | default: 'Close'

  # Blank uses the Duet wordmark built into garden-splash.js.
  assign flower_logo_url = ''
  if section.settings.flower_logo != blank
    assign flower_logo_url = section.settings.flower_logo | image_url: width: 900
  endif

  assign has_menu = false
  if garden_menu != blank and garden_menu.links.size > 0
    assign has_menu = true
  endif

  assign ground_brightness = section.settings.soil_color | color_brightness
  if ground_brightness > 153
    assign hud_ink = '#191F6B'
  else
    assign hud_ink = '#B9E5FB'
  endif
-%}

{%- capture palette_json -%}
  ["{{ section.settings.color_1 }}","{{ section.settings.color_2 }}","{{ section.settings.color_3 }}","{{ section.settings.color_4 }}","{{ section.settings.color_5 }}","{{ section.settings.color_6 }}"]
{%- endcapture -%}

<script type="module" src="{{ 'garden-splash.js' | asset_url }}"></script>

<garden-splash
  id="GardenSplash-{{ section.id }}"
  class="garden-splash"
  data-center-color="{{ section.settings.center_color }}"
  data-center-accent="{{ section.settings.center_accent_color }}"
  data-palette="{{ palette_json | escape }}"
  data-foliage-color="{{ section.settings.foliage_color }}"
  data-soil-color="{{ section.settings.soil_color }}"
  data-duration="{{ section.settings.bloom_duration }}"
  data-density="{{ section.settings.density }}"
  {% if flower_logo_url != blank %}data-flower-logo="{{ flower_logo_url }}"{% endif %}
  style="--gs-ground: {{ section.settings.soil_color }}; --gs-ink: {{ hud_ink }}; --gs-hero: {{ section.settings.center_color }}; --gs-logo-width: {{ logo_width }}px; --gs-menu-image-width: {{ section.settings.menu_image_width | default: 64 }}px;"
>
  <canvas class="garden-splash__canvas" data-garden-canvas aria-hidden="true"></canvas>
  <canvas class="garden-splash__overlay" data-garden-overlay aria-hidden="true"></canvas>

  {%- if has_menu -%}
    {%- comment -%}
      Once the flowers have formed the logo, the logo itself opens the menu.
      garden-splash.js sizes this button to the logo and shows it then.
    {%- endcomment -%}
    <button
      type="button"
      class="garden-splash__logo-trigger"
      data-garden-logo-trigger
      data-garden-nav-toggle
      data-garden-ui
      aria-expanded="false"
      aria-controls="GardenSplashNav-{{ section.id }}"
      aria-label="{{ shop.name | escape }}: {{ menu_label | escape }}"
      hidden
    ></button>
  {%- endif -%}

  {%- capture logo_img -%}
    {%- if logo_image != blank -%}
      {{
        logo_image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 480, 640, 900',
          sizes: '(min-width: 750px) 320px, 50vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: shop.name,
          class: 'garden-splash__logo-img'
      }}
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%}
    The flowers form the logo, so a flat logo is only shown at the top of the
    screen when chosen, and in the center when the 3D garden can't run.
  {%- endcomment -%}
  {%- if logo_position == 'top' and logo_img != blank -%}
    {%- if section.settings.logo_link != blank -%}
      <a class="garden-splash__top-logo" href="{{ section.settings.logo_link }}" data-garden-ui>{{ logo_img }}</a>
    {%- else -%}
      <h1 class="garden-splash__top-logo">{{ logo_img }}</h1>
    {%- endif -%}
  {%- else -%}
    <div class="garden-splash__center">
      <h1 class="garden-splash__logo" data-garden-logo>
        {%- if logo_img != blank -%}
          {{ logo_img }}
        {%- else -%}
          <span class="garden-splash__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </h1>
    </div>
  {%- endif -%}

  {%- if has_menu -%}
    <div class="garden-splash__hud garden-splash__hud--tr" data-garden-ui>
      <button
        type="button"
        id="GardenSplashMenu-{{ section.id }}"
        class="garden-splash__menu garden-splash__menu--{{ menu_style }}"
        data-garden-menu
        data-garden-nav-toggle
        data-open-label="{{ menu_label | escape }}"
        data-close-label="{{ menu_close_label | escape }}"
        aria-expanded="false"
        aria-controls="GardenSplashNav-{{ section.id }}"
        {% if menu_style == 'image' and section.settings.menu_image != blank %}
          aria-label="{{ menu_label | escape }}"
        {% endif %}
      >
        {%- if menu_style == 'image' and section.settings.menu_image != blank -%}
          {{
            section.settings.menu_image
            | image_url: width: 400
            | image_tag: loading: 'eager', alt: '', class: 'garden-splash__menu-img'
          }}
        {%- else -%}
          <span data-garden-menu-label>{{ menu_label | escape }}</span>
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.show_schemes -%}
    {%- comment -%}
      Visitor color schemes: the store's own colors first, then the same
      palette turned around the color wheel (data-hue, in degrees). The
      script works out each scheme's colors and paints the swatches.
    {%- endcomment -%}
    <div class="garden-splash__schemes" role="group" aria-label="Flower colors" data-garden-ui>
      {%- assign scheme_names = 'House,Gold,Teal,Cobalt,Violet' | split: ',' -%}
      {%- assign scheme_hues = '0,60,180,240,300' | split: ',' -%}
      {%- for name in scheme_names -%}
        <button
          type="button"
          class="garden-splash__swatch"
          data-garden-scheme
          data-hue="{{ scheme_hues[forloop.index0] }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ name }} colors"
          title="{{ name }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.hint_text != blank -%}
    <p class="garden-splash__hud garden-splash__hint" aria-hidden="true">{{ section.settings.hint_text | escape }}</p>
  {%- endif -%}

  {%- if has_menu -%}
    <nav
      id="GardenSplashNav-{{ section.id }}"
      class="garden-splash__nav"
      data-garden-nav
      data-garden-ui
      aria-label="{{ garden_menu.title | escape }}"
    >
      <button type="button" class="garden-splash__nav-close" data-garden-nav-toggle>
        {{- menu_close_label | escape -}}
      </button>
      <ol class="garden-splash__nav-list" role="list">
        {%- for link in garden_menu.links -%}
          <li class="garden-splash__nav-item">
            <a href="{{ link.url }}" class="garden-splash__nav-link">{{ link.title | escape }}</a>
            {%- if link.links != blank -%}
              <ul class="garden-splash__nav-sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="garden-splash__nav-link garden-splash__nav-link--sub">
                      {{- child.title | escape -}}
                    </a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}" class="garden-splash__nav-link garden-splash__nav-link--sub garden-splash__nav-link--deep">
                        {{- grandchild.title | escape -}}
                      </a>
                    {%- endfor -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if settings.garden_game != false -%}
          <li class="garden-splash__nav-item">
            <button
              type="button"
              class="garden-splash__nav-link garden-splash__nav-link--game"
              data-pollen-dream
              data-return-focus="#GardenSplashMenu-{{ section.id }}"
            >
              {{- settings.garden_game_label | default: 'Pollen Dream' | escape -}}
            </button>
          </li>
        {%- endif -%}
      </ol>
    </nav>
  {%- endif -%}
</garden-splash>

{%- if has_menu -%}
  <script>
    // The menu works on its own, whether or not the 3D garden manages to start.
    // The flower logo (once formed) or the menu button opens it; Escape, the
    // close button or either trigger closes it. Focus stays inside while it
    // is open and goes back to whichever trigger opened it.
    (function () {
      var root = document.getElementById('GardenSplash-{{ section.id }}');
      if (!root || root.toggleNav) return;
      var nav = root.querySelector('[data-garden-nav]');
      var menu = root.querySelector('[data-garden-menu]');
      var label = root.querySelector('[data-garden-menu-label]');
      var toggles = root.querySelectorAll('[data-garden-nav-toggle]');
      if (!nav) return;
      var opener = null;
      function focusables() {
        return Array.prototype.filter.call(nav.querySelectorAll('a[href], button:not([disabled])'), function (el) {
          return el.offsetParent !== null;
        });
      }
      function toggle(force, quiet) {
        var open = typeof force === 'boolean' ? force : !root.classList.contains('is-nav-open');
        if (open === root.classList.contains('is-nav-open')) return;
        root.classList.toggle('is-nav-open', open);
        document.documentElement.classList.toggle('garden-nav-locked', open);
        for (var i = 0; i < toggles.length; i++) {
          if (toggles[i].hasAttribute('aria-controls')) toggles[i].setAttribute('aria-expanded', String(open));
        }
        if (label) label.textContent = open ? menu.getAttribute('data-close-label') : menu.getAttribute('data-open-label');
        if (open) {
          opener = root.contains(document.activeElement) ? document.activeElement : menu;
          var first = nav.querySelector('a, button:not(.garden-splash__nav-close)');
          if (first) first.focus({ preventScroll: true });
        } else if (!quiet) {
          var back = opener && opener.offsetParent !== null ? opener : menu;
          if (back) back.focus({ preventScroll: true });
        }
      }
      root.toggleNav = toggle;
      for (var i = 0; i < toggles.length; i++) {
        toggles[i].addEventListener('click', function () {
          // With the site header on the page, the flower logo opens that same menu, out of the logo.
          var header = document.querySelector('duet-header');
          if (this.hasAttribute('data-garden-logo-trigger') && header && header.openMenu) {
            header.openMenu(this);
            return;
          }
          toggle();
        });
      }
      // Starting the game closes the menu; the game puts focus back when it ends.
      nav.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('[data-pollen-dream]')) toggle(false, true);
      });
      function onKey(e) {
        if (!root.isConnected) {
          document.removeEventListener('keydown', onKey);
          return;
        }
        if (!root.classList.contains('is-nav-open')) return;
        if (e.key === 'Escape') {
          toggle(false);
        } else if (e.key === 'Tab') {
          var items = focusables();
          if (!items.length) return;
          var first = items[0];
          var last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && (document.activeElement === last || !nav.contains(document.activeElement))) {
            e.preventDefault();
            first.focus();
          }
        }
      }
      document.addEventListener('keydown', onKey);
      // Coming back with the browser's back button: the menu starts closed.
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) toggle(false, true);
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .garden-splash {
    --gs-mono: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    position: relative;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
    color: var(--gs-ink, #b9e5fb);
    font-family: var(--gs-mono);
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
  }

  /* The 3D render is drawn at low resolution and scaled up with hard pixels. */
  .garden-splash__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .garden-splash__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------- Logo ---------- */

  /* Optional flat logo at the top center; the flowers form the logo themselves. */
  .garden-splash__top-logo {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    left: 50%;
    z-index: 6;
    display: block;
    width: var(--gs-logo-width, 120px);
    max-width: calc(100% - 220px);
    margin: 0;
    color: inherit;
    transform: translateX(-50%);
  }

  h1.garden-splash__top-logo {
    pointer-events: none;
  }

  .garden-splash__top-logo .garden-splash__logo-img {
    filter: none;
  }

  /* The center copy is only seen when the 3D garden can't run. */
  .garden-splash__center {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 0;
    height: 0;
  }

  .garden-splash__logo {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: min(60vw, 22rem);
    margin: 0;
    font: inherit;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .garden-splash.is-ready:not(.is-static) .garden-splash__center {
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Without the 3D garden, only the logo and the menu remain. */
  .garden-splash.is-static .garden-splash__schemes,
  .garden-splash.is-static .garden-splash__hint,
  .garden-splash.is-static .garden-splash__overlay {
    display: none;
  }

  .garden-splash__logo-img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(2px 0 0 rgba(240, 78, 98, 0.55)) drop-shadow(-2px 0 0 rgba(102, 164, 200, 0.55));
  }

  .garden-splash__logo-text {
    font-size: 1.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* ---------- Controls ---------- */

  .garden-splash__hud {
    position: absolute;
    z-index: 6;
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: pre;
    pointer-events: none;
  }

  .garden-splash__hud--tr {
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
  }

  .garden-splash__hint {
    left: 50%;
    bottom: max(56px, calc(env(safe-area-inset-bottom) + 40px));
    z-index: 4;
    padding: 8px 10px;
    background: var(--gs-ground, #191f6b);
    transform: translateX(-50%);
  }

  .garden-splash.has-interacted .garden-splash__hint,
  .garden-splash.is-nav-open .garden-splash__hint {
    display: none;
  }

  /* Visitors pick the flower colors: one dot per scheme. */
  .garden-splash__schemes {
    position: absolute;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 4;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }

  .garden-splash:not(.is-ready) .garden-splash__schemes,
  .garden-splash.is-nav-open .garden-splash__schemes {
    visibility: hidden;
  }

  .garden-splash__swatch {
    width: 20px;
    height: 20px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--gs-ink, #191f6b);
    border-radius: 50%;
    background: conic-gradient(var(--s1) 0 33%, var(--s2) 0 67%, var(--s3) 0);
    cursor: pointer;
  }

  .garden-splash__swatch[aria-pressed='true'] {
    outline: 1px solid var(--gs-ink, #191f6b);
    outline-offset: 3px;
  }

  .garden-splash__swatch:focus-visible {
    outline: 1px dashed var(--gs-ink, #191f6b);
    outline-offset: 3px;
  }

  /* Menu button: outline, filled plate, plain text, or a custom image. */
  .garden-splash__menu {
    margin: 0;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    pointer-events: auto;
  }

  .garden-splash__menu--outline {
    border-color: currentColor;
  }

  .garden-splash__menu--filled {
    border-color: currentColor;
    background: var(--gs-ground, #191f6b);
  }

  .garden-splash__menu--outline:hover,
  .garden-splash__menu--filled:hover {
    background: var(--gs-ink, #b9e5fb);
    color: var(--gs-ground, #191f6b);
  }

  .garden-splash__menu--text {
    padding: 8px 0;
  }

  .garden-splash__menu--text:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .garden-splash__menu--image {
    padding: 0;
  }

  .garden-splash__menu-img {
    display: block;
    width: var(--gs-menu-image-width, 64px);
    height: auto;
  }

  .garden-splash__menu--image:hover {
    opacity: 0.7;
  }

  .garden-splash__menu:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  /* ---------- The formed logo as the menu button ---------- */

  .garden-splash__logo-trigger {
    position: absolute;
    left: var(--gs-trigger-x, 0);
    top: var(--gs-trigger-y, 0);
    z-index: 4;
    width: var(--gs-trigger-w, 0);
    height: var(--gs-trigger-h, 0);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
  }

  .garden-splash__logo-trigger[hidden] {
    display: none;
  }

  .garden-splash__logo-trigger:focus-visible {
    outline: 1px dashed var(--gs-ink, #191f6b);
    outline-offset: 4px;
  }

  /* Without the 3D garden the flat logo in the center opens the menu instead. */
  .garden-splash.is-static .garden-splash__logo-trigger {
    display: block;
    left: 50%;
    top: 50%;
    width: min(60vw, 22rem);
    height: min(30vw, 11rem);
    transform: translate(-50%, -50%);
  }

  .garden-splash.is-nav-open .garden-splash__logo-trigger {
    visibility: hidden;
  }

  /* Zoomed in, the logo is for looking at: taps reach the flowers, drags move the view. */
  .garden-splash.is-zoomed {
    cursor: grab;
  }

  .garden-splash.is-zoomed:active {
    cursor: grabbing;
  }

  .garden-splash.is-zoomed .garden-splash__logo-trigger {
    pointer-events: none;
  }

  /* The night sky (garden-splash.js): just the sky, no logo button or pointer readout. */
  .garden-splash.is-night .garden-splash__logo-trigger,
  .garden-splash.is-night .garden-splash__overlay {
    display: none;
  }

  html.garden-night duet-header {
    --dh-ink: #b9e5fb !important;
  }

  /* ---------- Menu ---------- */

  /* It opens out of the logo: a circle that grows from the logo's center. */
  .garden-splash__nav {
    position: absolute;
    inset: 0;
    z-index: 7;
    display: flex;
    align-items: flex-start;
    padding: 72px max(16px, 8vw);
    background: color-mix(in srgb, var(--gs-ground, #191f6b) 88%, transparent);
    cursor: default;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    clip-path: circle(0 at var(--gs-origin-x, 50%) var(--gs-origin-y, 50%));
    transition: opacity 0.3s linear, clip-path 0.45s cubic-bezier(0.6, 0, 0.8, 0.2), visibility 0s linear 0.45s;
  }

  .garden-splash.is-nav-open .garden-splash__nav {
    opacity: 1;
    visibility: visible;
    clip-path: circle(150vmax at var(--gs-origin-x, 50%) var(--gs-origin-y, 50%));
    transition: opacity 0.2s linear, clip-path 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .garden-splash__nav-list {
    transform: scale(0.97);
    transform-origin: var(--gs-origin-x, 50%) var(--gs-origin-y, 50%);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .garden-splash.is-nav-open .garden-splash__nav-list {
    transform: none;
  }

  /* The menu has its own close button where the menu button was. */
  .garden-splash.is-nav-open .garden-splash__hud--tr {
    visibility: hidden;
  }

  .garden-splash__nav-close {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
    margin: 0;
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .garden-splash__nav-close:hover,
  .garden-splash__nav-close:focus-visible {
    background: var(--gs-ink, #b9e5fb);
    color: var(--gs-ground, #191f6b);
    outline: none;
  }

  /* The game's entry sits in the list like any other link. */
  .garden-splash__nav-link--game {
    width: 100%;
    margin: 0;
    border: 0;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .garden-splash__nav-link--game::after {
    content: '✱';
    margin-left: auto;
    font-size: 0.6em;
    color: var(--gs-hero, #f04e62);
  }

  /* No page scroll behind an open menu. */
  html.garden-nav-locked,
  html.garden-nav-locked body {
    overflow: hidden;
  }

  .garden-splash__nav-list {
    display: grid;
    gap: 4px;
    width: 100%;
    max-width: 720px;
    /* Centered when it fits; scrolls from the first item when it doesn't. */
    margin: auto 0;
    padding: 0;
    list-style: none;
    counter-reset: garden-nav;
  }

  .garden-splash__nav-item {
    counter-increment: garden-nav;
    border-top: 1px solid currentColor;
  }

  .garden-splash__nav-item:last-child {
    border-bottom: 1px solid currentColor;
  }

  .garden-splash__nav-link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 14px 0;
    color: inherit;
    font-size: clamp(20px, 3.2vw, 32px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 2px 0 rgba(240, 78, 98, 0.5), -2px 0 rgba(102, 164, 200, 0.5);
  }

  .garden-splash__nav-item > .garden-splash__nav-link::before {
    content: counter(garden-nav, decimal-leading-zero);
    font-size: 11px;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }

  .garden-splash__nav-link:hover,
  .garden-splash__nav-link:focus-visible {
    color: var(--gs-hero, #f04e62);
    outline: none;
  }

  .garden-splash__nav-sublist {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: -6px 0 12px 40px;
    padding: 0;
    list-style: none;
  }

  .garden-splash__nav-link--deep {
    padding-left: 12px;
    opacity: 0.8;
  }

  .garden-splash__nav-link--sub {
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  @media (max-width: 749px) {
    .garden-splash__hint {
      white-space: normal;
      width: max-content;
      max-width: calc(100% - 32px);
      text-align: center;
      line-height: 1.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-splash__nav,
    .garden-splash.is-nav-open .garden-splash__nav,
    .garden-splash__nav-list {
      transition: none;
    }
  }
{% endstylesheet %}

