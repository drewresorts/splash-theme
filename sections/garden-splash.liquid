{%- liquid
  assign logo_image = section.settings.logo | default: settings.splash_streams_logo
  assign garden_menu = section.settings.menu
  assign logo_size = section.settings.logo_size | default: 55
  assign logo_ratio = logo_size | times: 0.01

  assign has_menu = false
  if garden_menu != blank and garden_menu.links.size > 0
    assign has_menu = true
  endif

  assign ground_brightness = section.settings.soil_color | color_brightness
  if ground_brightness > 153
    assign hud_ink = '#191F6B'
  else
    assign hud_ink = '#B9E5FB'
  endif
-%}

{%- capture palette_json -%}
  ["{{ section.settings.color_1 }}","{{ section.settings.color_2 }}","{{ section.settings.color_3 }}","{{ section.settings.color_4 }}","{{ section.settings.color_5 }}","{{ section.settings.color_6 }}"]
{%- endcapture -%}

<script type="module" src="{{ 'garden-splash.js' | asset_url }}"></script>

<garden-splash
  class="garden-splash"
  data-center-color="{{ section.settings.center_color }}"
  data-center-accent="{{ section.settings.center_accent_color }}"
  data-palette="{{ palette_json | escape }}"
  data-foliage-color="{{ section.settings.foliage_color }}"
  data-soil-color="{{ section.settings.soil_color }}"
  data-duration="{{ section.settings.bloom_duration }}"
  data-density="{{ section.settings.density }}"
  data-logo-scale="{{ logo_ratio }}"
  style="--gs-ground: {{ section.settings.soil_color }}; --gs-ink: {{ hud_ink }}; --gs-hero: {{ section.settings.center_color }};"
>
  <canvas class="garden-splash__canvas" data-garden-canvas aria-hidden="true"></canvas>
  <canvas class="garden-splash__overlay" data-garden-overlay aria-hidden="true"></canvas>

  <div class="garden-splash__center">
    {%- capture logo_markup -%}
      {%- if logo_image != blank -%}
        {{
          logo_image
          | image_url: width: 900
          | image_tag:
            widths: '240, 360, 480, 640, 900',
            sizes: '(min-width: 750px) 420px, 60vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: shop.name,
            class: 'garden-splash__logo-img'
        }}
      {%- else -%}
        <span class="garden-splash__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if has_menu -%}
      <button
        type="button"
        class="garden-splash__logo"
        data-garden-logo
        data-garden-ui
        data-garden-nav-toggle
        aria-expanded="false"
        aria-controls="GardenSplashNav-{{ section.id }}"
        aria-label="{{ shop.name | escape }} menu"
      >
        {{ logo_markup }}
      </button>
    {%- elsif section.settings.logo_link != blank -%}
      <a class="garden-splash__logo" href="{{ section.settings.logo_link }}" data-garden-logo data-garden-ui>
        {{ logo_markup }}
      </a>
    {%- else -%}
      <h1 class="garden-splash__logo" data-garden-logo>
        {{ logo_markup }}
      </h1>
    {%- endif -%}
  </div>

  {%- if section.settings.hud_label != blank -%}
    <p class="garden-splash__hud garden-splash__hud--tl">{{ section.settings.hud_label | escape }}</p>
  {%- endif -%}

  {%- if has_menu -%}
    <div class="garden-splash__hud garden-splash__hud--tr" data-garden-ui>
      <button
        type="button"
        class="garden-splash__btn"
        data-garden-menu
        data-garden-nav-toggle
        data-open-label="Menu"
        data-close-label="Close"
        aria-expanded="false"
        aria-controls="GardenSplashNav-{{ section.id }}"
      >
        Menu
      </button>
    </div>
  {%- endif -%}

  <div class="garden-splash__hud garden-splash__hud--bl" data-garden-ui>
    <span class="garden-splash__readout" aria-hidden="true">Bloom <span data-garden-bloom>000%</span></span>
    {%- if section.settings.show_replant -%}
      <button type="button" class="garden-splash__btn" data-garden-replant>Reset</button>
    {%- endif -%}
  </div>

  <p class="garden-splash__hud garden-splash__hud--br" aria-hidden="true">
    <span class="garden-splash__readout" data-garden-coords>X    0  Y    0</span>
  </p>

  {%- if section.settings.hint_text != blank -%}
    <p class="garden-splash__hud garden-splash__hint" aria-hidden="true">{{ section.settings.hint_text | escape }}</p>
  {%- endif -%}

  {%- if has_menu -%}
    <nav
      id="GardenSplashNav-{{ section.id }}"
      class="garden-splash__nav"
      data-garden-nav
      data-garden-ui
      aria-label="{{ garden_menu.title | escape }}"
    >
      <ol class="garden-splash__nav-list" role="list">
        {%- for link in garden_menu.links -%}
          <li class="garden-splash__nav-item">
            <a href="{{ link.url }}" class="garden-splash__nav-link">{{ link.title | escape }}</a>
            {%- if link.links != blank -%}
              <ul class="garden-splash__nav-sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="garden-splash__nav-link garden-splash__nav-link--sub">
                      {{- child.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </nav>
  {%- endif -%}
</garden-splash>

{% stylesheet %}
  .garden-splash {
    --gs-mono: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    position: relative;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
    color: var(--gs-ink, #b9e5fb);
    font-family: var(--gs-mono);
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The 3D render is drawn at low resolution and scaled up with hard pixels. */
  .garden-splash__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .garden-splash__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------- Logo ---------- */

  .garden-splash__center {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 0;
    height: 0;
  }

  .garden-splash__logo {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: var(--garden-logo-size, min(56vw, 22rem));
    aspect-ratio: 1;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s linear;
  }

  h1.garden-splash__logo {
    cursor: crosshair;
    pointer-events: none;
  }

  .garden-splash.is-ready:not(.is-bloomed) .garden-splash__logo,
  .garden-splash.is-nav-open .garden-splash__logo {
    opacity: 0;
    pointer-events: none;
  }

  .garden-splash.is-ready:not(.is-bloomed) .garden-splash__logo:focus-visible {
    opacity: 1;
  }

  .garden-splash__logo:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 6px;
  }

  /* Slight color fringing, like a lens or an old print. */
  /* Once the logo is painted onto the 3D flower, this copy stays as an invisible button. */
  .garden-splash.has-3d-logo .garden-splash__logo-img,
  .garden-splash.has-3d-logo .garden-splash__logo-text {
    opacity: 0;
  }

  .garden-splash__logo-img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(2px 0 0 rgba(240, 78, 98, 0.55)) drop-shadow(-2px 0 0 rgba(102, 164, 200, 0.55));
  }

  .garden-splash__logo-text {
    font-size: 1.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* ---------- Instrument readouts ---------- */

  .garden-splash__hud {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: pre;
    text-shadow: 1px 0 rgba(240, 78, 98, 0.55), -1px 0 rgba(102, 164, 200, 0.55);
    pointer-events: none;
  }

  .garden-splash__hud--tl {
    top: max(16px, env(safe-area-inset-top));
    left: max(16px, env(safe-area-inset-left));
  }

  .garden-splash__hud--tr {
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
    z-index: 6;
  }

  .garden-splash__hud--bl {
    bottom: max(16px, env(safe-area-inset-bottom));
    left: max(16px, env(safe-area-inset-left));
  }

  .garden-splash__hud--br {
    bottom: max(16px, env(safe-area-inset-bottom));
    right: max(16px, env(safe-area-inset-right));
  }

  /* Readouts sit on solid plates so they stay legible over the field. */
  .garden-splash__hud--tl,
  .garden-splash__readout,
  .garden-splash__hint {
    padding: 8px 10px;
    background: var(--gs-ground, #191f6b);
    font-variant-numeric: tabular-nums;
  }

  .garden-splash__hud--bl {
    gap: 0;
  }

  .garden-splash__hud--bl .garden-splash__btn {
    margin-left: -1px;
  }

  .garden-splash__hud--br {
    gap: 0;
  }

  .garden-splash__hint {
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
  }

  .garden-splash.has-interacted .garden-splash__hint,
  .garden-splash.is-nav-open .garden-splash__hint {
    display: none;
  }

  .garden-splash__btn {
    min-width: 72px;
    margin: 0;
    padding: 8px 10px;
    border: 1px solid currentColor;
    border-radius: 0;
    background: var(--gs-ground, #191f6b);
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    pointer-events: auto;
  }

  .garden-splash__btn:hover,
  .garden-splash__btn:focus-visible {
    background: var(--gs-ink, #b9e5fb);
    color: var(--gs-ground, #191f6b);
  }

  .garden-splash__btn:focus-visible {
    outline: 1px solid var(--gs-ink, #b9e5fb);
    outline-offset: 2px;
  }

  /* ---------- Menu ---------- */

  .garden-splash__nav {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 72px max(16px, 8vw);
    background: color-mix(in srgb, var(--gs-ground, #191f6b) 88%, transparent);
    cursor: default;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s linear, visibility 0s linear 0.12s;
  }

  .garden-splash.is-nav-open .garden-splash__nav {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.12s linear;
  }

  .garden-splash__nav-list {
    display: grid;
    gap: 4px;
    width: 100%;
    max-width: 720px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: garden-nav;
  }

  .garden-splash__nav-item {
    counter-increment: garden-nav;
    border-top: 1px solid currentColor;
  }

  .garden-splash__nav-item:last-child {
    border-bottom: 1px solid currentColor;
  }

  .garden-splash__nav-link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 14px 0;
    color: inherit;
    font-size: clamp(20px, 3.2vw, 32px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 2px 0 rgba(240, 78, 98, 0.5), -2px 0 rgba(102, 164, 200, 0.5);
  }

  .garden-splash__nav-item > .garden-splash__nav-link::before {
    content: counter(garden-nav, decimal-leading-zero);
    font-size: 11px;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }

  .garden-splash__nav-link:hover,
  .garden-splash__nav-link:focus-visible {
    color: var(--gs-hero, #f04e62);
    outline: none;
  }

  .garden-splash__nav-sublist {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: -6px 0 12px 40px;
    padding: 0;
    list-style: none;
  }

  .garden-splash__nav-link--sub {
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  @media (max-width: 749px) {
    .garden-splash__hud--br {
      display: none;
    }

    .garden-splash__hint {
      bottom: max(64px, calc(env(safe-area-inset-bottom) + 48px));
      white-space: normal;
      width: max-content;
      max-width: calc(100% - 32px);
      text-align: center;
      line-height: 1.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-splash__logo,
    .garden-splash__nav {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Garden splash",
  "tag": "section",
  "class": "section--garden-splash",
  "settings": [
    {
      "type": "paragraph",
      "content": "A 3D flower bed seen from above on a transparent background, rendered like cheap late-90s CGI, some flowers with eyes that follow the visitor. The center flower unfolds to reveal your logo. Each grows from seed to full bloom, and the center specimen resolves last with your logo on it. Visitors can hover to inspect a specimen, press and drag to accelerate growth, and tap to resequence a specimen and make the eyes blink. Built to fill the whole screen, so it works best as the only section on a page."
    },
    {
      "type": "header",
      "content": "Logo & menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Center logo",
      "info": "Leave blank to use Theme settings → Splash streams page → Center logo."
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "info": "Relative to the center flower.",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "When set, tapping the logo opens this menu over the garden."
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link",
      "info": "Used when no menu is selected."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "center_color",
      "label": "Center flower",
      "default": "#F04E62"
    },
    {
      "type": "color",
      "id": "center_accent_color",
      "label": "Center flower back layer",
      "default": "#A62749"
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "Garden color 1",
      "default": "#A62749"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Garden color 2",
      "default": "#66A4C8"
    },
    {
      "type": "color",
      "id": "color_3",
      "label": "Garden color 3",
      "default": "#191F6B"
    },
    {
      "type": "color",
      "id": "color_4",
      "label": "Garden color 4",
      "default": "#B9E5FB"
    },
    {
      "type": "color",
      "id": "color_5",
      "label": "Garden color 5",
      "default": "#F04E62"
    },
    {
      "type": "color",
      "id": "color_6",
      "label": "Garden color 6",
      "default": "#B9E5FB"
    },
    {
      "type": "color",
      "id": "foliage_color",
      "label": "Leaves",
      "default": "#66A4C8"
    },
    {
      "type": "color",
      "id": "soil_color",
      "label": "Interface plates",
      "default": "#191F6B",
      "info": "Behind the readouts, buttons and menu. The garden itself has a transparent background."
    },
    {
      "type": "header",
      "content": "Growth"
    },
    {
      "type": "range",
      "id": "bloom_duration",
      "label": "Time to full bloom",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 12
    },
    {
      "type": "select",
      "id": "density",
      "label": "Garden density",
      "default": "lush",
      "options": [
        { "value": "airy", "label": "Airy — larger flowers" },
        { "value": "lush", "label": "Lush" },
        { "value": "overgrown", "label": "Overgrown — smaller, more flowers" }
      ]
    },
    {
      "type": "text",
      "id": "hud_label",
      "label": "Corner label",
      "default": "Richmond VA  37.5407N  77.4360W",
      "info": "Shown in the top-left corner. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Press + drag to grow  /  Tap to make them blink",
      "info": "Hidden after the first interaction. Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_replant",
      "label": "Show reset button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Garden splash"
    }
  ]
}
{% endschema %}
