{%- liquid
  assign logo_image = section.settings.logo | default: settings.splash_streams_logo
  assign garden_menu = section.settings.menu
  assign logo_position = section.settings.logo_position | default: 'top'
  assign logo_width = section.settings.logo_width | default: 120
  assign menu_style = section.settings.menu_style | default: 'outline'
  assign menu_label = section.settings.menu_label | default: 'Menu'
  assign menu_close_label = section.settings.menu_close_label | default: 'Close'

  # Blank uses the Duet wordmark built into garden-splash.js.
  assign flower_logo_url = ''
  if section.settings.flower_logo != blank
    assign flower_logo_url = section.settings.flower_logo | image_url: width: 900
  endif

  assign has_menu = false
  if garden_menu != blank and garden_menu.links.size > 0
    assign has_menu = true
  endif

  assign ground_brightness = section.settings.soil_color | color_brightness
  if ground_brightness > 153
    assign hud_ink = '#191F6B'
  else
    assign hud_ink = '#B9E5FB'
  endif
-%}

{%- capture palette_json -%}
  ["{{ section.settings.color_1 }}","{{ section.settings.color_2 }}","{{ section.settings.color_3 }}","{{ section.settings.color_4 }}","{{ section.settings.color_5 }}","{{ section.settings.color_6 }}"]
{%- endcapture -%}

<script type="module" src="{{ 'garden-splash.js' | asset_url }}"></script>

<garden-splash
  id="GardenSplash-{{ section.id }}"
  class="garden-splash"
  data-center-color="{{ section.settings.center_color }}"
  data-center-accent="{{ section.settings.center_accent_color }}"
  data-palette="{{ palette_json | escape }}"
  data-foliage-color="{{ section.settings.foliage_color }}"
  data-soil-color="{{ section.settings.soil_color }}"
  data-duration="{{ section.settings.bloom_duration }}"
  data-density="{{ section.settings.density }}"
  {% if flower_logo_url != blank %}data-flower-logo="{{ flower_logo_url }}"{% endif %}
  style="--gs-ground: {{ section.settings.soil_color }}; --gs-ink: {{ hud_ink }}; --gs-hero: {{ section.settings.center_color }}; --gs-logo-width: {{ logo_width }}px; --gs-menu-image-width: {{ section.settings.menu_image_width | default: 64 }}px;"
>
  <canvas class="garden-splash__canvas" data-garden-canvas aria-hidden="true"></canvas>
  <canvas class="garden-splash__overlay" data-garden-overlay aria-hidden="true"></canvas>

  {%- capture logo_img -%}
    {%- if logo_image != blank -%}
      {{
        logo_image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 480, 640, 900',
          sizes: '(min-width: 750px) 320px, 50vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: shop.name,
          class: 'garden-splash__logo-img'
      }}
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%}
    The flowers form the logo, so a flat logo is only shown at the top of the
    screen when chosen, and in the center when the 3D garden can't run.
  {%- endcomment -%}
  {%- if logo_position == 'top' and logo_img != blank -%}
    {%- if section.settings.logo_link != blank -%}
      <a class="garden-splash__top-logo" href="{{ section.settings.logo_link }}" data-garden-ui>{{ logo_img }}</a>
    {%- else -%}
      <h1 class="garden-splash__top-logo">{{ logo_img }}</h1>
    {%- endif -%}
  {%- else -%}
    <div class="garden-splash__center">
      <h1 class="garden-splash__logo" data-garden-logo>
        {%- if logo_img != blank -%}
          {{ logo_img }}
        {%- else -%}
          <span class="garden-splash__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </h1>
    </div>
  {%- endif -%}

  {%- if has_menu -%}
    <div class="garden-splash__hud garden-splash__hud--tr" data-garden-ui>
      <button
        type="button"
        class="garden-splash__menu garden-splash__menu--{{ menu_style }}"
        data-garden-menu
        data-garden-nav-toggle
        data-open-label="{{ menu_label | escape }}"
        data-close-label="{{ menu_close_label | escape }}"
        aria-expanded="false"
        aria-controls="GardenSplashNav-{{ section.id }}"
        {% if menu_style == 'image' and section.settings.menu_image != blank %}
          aria-label="{{ menu_label | escape }}"
        {% endif %}
      >
        {%- if menu_style == 'image' and section.settings.menu_image != blank -%}
          {{
            section.settings.menu_image
            | image_url: width: 400
            | image_tag: loading: 'eager', alt: '', class: 'garden-splash__menu-img'
          }}
        {%- else -%}
          <span data-garden-menu-label>{{ menu_label | escape }}</span>
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.show_schemes -%}
    {%- comment -%}
      Visitor color schemes: the store's own colors first, then brand duochromes.
      Each swatch carries the colors the flowers switch to.
    {%- endcomment -%}
    {%- capture schemes -%}
      House|{{ palette_json | strip }}|{{ section.settings.foliage_color }}|{{ section.settings.center_color }}|{{ section.settings.center_accent_color }}
      Fuchsia|["#F04E62","#A62749","#B9E5FB"]|#66A4C8|#191F6B|#66A4C8
      Ocean|["#191F6B","#66A4C8","#B9E5FB"]|#A62749|#F04E62|#A62749
      Wine|["#A62749","#191F6B","#F04E62"]|#B9E5FB|#66A4C8|#B9E5FB
      Powder|["#B9E5FB","#66A4C8","#F04E62"]|#191F6B|#A62749|#191F6B
    {%- endcapture -%}
    <div class="garden-splash__schemes" role="group" aria-label="Flower colors" data-garden-ui>
      {%- assign scheme_lines = schemes | strip | newline_to_br | split: '<br />' -%}
      {%- for line in scheme_lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- assign swatch = parts[1] | remove: '[' | remove: ']' | remove: '"' | split: ',' -%}
        <button
          type="button"
          class="garden-splash__swatch"
          data-garden-scheme
          data-palette="{{ parts[1] | escape }}"
          data-foliage="{{ parts[2] }}"
          data-center="{{ parts[3] }}"
          data-accent="{{ parts[4] }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ parts[0] }} colors"
          title="{{ parts[0] }}"
          style="--s1: {{ swatch[0] }}; --s2: {{ swatch[1] | default: swatch[0] }}; --s3: {{ parts[3] }};"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.hint_text != blank -%}
    <p class="garden-splash__hud garden-splash__hint" aria-hidden="true">{{ section.settings.hint_text | escape }}</p>
  {%- endif -%}

  {%- if has_menu -%}
    <nav
      id="GardenSplashNav-{{ section.id }}"
      class="garden-splash__nav"
      data-garden-nav
      data-garden-ui
      aria-label="{{ garden_menu.title | escape }}"
    >
      <ol class="garden-splash__nav-list" role="list">
        {%- for link in garden_menu.links -%}
          <li class="garden-splash__nav-item">
            <a href="{{ link.url }}" class="garden-splash__nav-link">{{ link.title | escape }}</a>
            {%- if link.links != blank -%}
              <ul class="garden-splash__nav-sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="garden-splash__nav-link garden-splash__nav-link--sub">
                      {{- child.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </nav>
  {%- endif -%}
</garden-splash>

{%- if has_menu -%}
  <script>
    // The menu works on its own, whether or not the 3D garden manages to start.
    (function () {
      var root = document.getElementById('GardenSplash-{{ section.id }}');
      if (!root) return;
      var nav = root.querySelector('[data-garden-nav]');
      var menu = root.querySelector('[data-garden-menu]');
      var label = root.querySelector('[data-garden-menu-label]');
      var toggles = root.querySelectorAll('[data-garden-nav-toggle]');
      if (!nav) return;
      function toggle(force) {
        var open = typeof force === 'boolean' ? force : !root.classList.contains('is-nav-open');
        root.classList.toggle('is-nav-open', open);
        for (var i = 0; i < toggles.length; i++) toggles[i].setAttribute('aria-expanded', String(open));
        if (label) label.textContent = open ? menu.getAttribute('data-close-label') : menu.getAttribute('data-open-label');
        if (open) {
          var first = nav.querySelector('a');
          if (first) first.focus({ preventScroll: true });
        } else if (menu && root.contains(document.activeElement)) {
          menu.focus({ preventScroll: true });
        }
      }
      root.toggleNav = toggle;
      for (var i = 0; i < toggles.length; i++) {
        toggles[i].addEventListener('click', function () {
          toggle();
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('is-nav-open')) toggle(false);
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .garden-splash {
    --gs-mono: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    position: relative;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
    color: var(--gs-ink, #b9e5fb);
    font-family: var(--gs-mono);
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The 3D render is drawn at low resolution and scaled up with hard pixels. */
  .garden-splash__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .garden-splash__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------- Logo ---------- */

  /* Optional flat logo at the top center; the flowers form the logo themselves. */
  .garden-splash__top-logo {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    left: 50%;
    z-index: 6;
    display: block;
    width: var(--gs-logo-width, 120px);
    max-width: calc(100% - 220px);
    margin: 0;
    color: inherit;
    transform: translateX(-50%);
  }

  h1.garden-splash__top-logo {
    pointer-events: none;
  }

  .garden-splash__top-logo .garden-splash__logo-img {
    filter: none;
  }

  /* The center copy is only seen when the 3D garden can't run. */
  .garden-splash__center {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 0;
    height: 0;
  }

  .garden-splash__logo {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: min(60vw, 22rem);
    margin: 0;
    font: inherit;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .garden-splash.is-ready:not(.is-static) .garden-splash__center {
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Without the 3D garden, only the logo and the menu remain. */
  .garden-splash.is-static .garden-splash__schemes,
  .garden-splash.is-static .garden-splash__hint,
  .garden-splash.is-static .garden-splash__overlay {
    display: none;
  }

  .garden-splash__logo-img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(2px 0 0 rgba(240, 78, 98, 0.55)) drop-shadow(-2px 0 0 rgba(102, 164, 200, 0.55));
  }

  .garden-splash__logo-text {
    font-size: 1.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* ---------- Controls ---------- */

  .garden-splash__hud {
    position: absolute;
    z-index: 6;
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: pre;
    pointer-events: none;
  }

  .garden-splash__hud--tr {
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
  }

  .garden-splash__hint {
    left: 50%;
    bottom: max(56px, calc(env(safe-area-inset-bottom) + 40px));
    z-index: 4;
    padding: 8px 10px;
    background: var(--gs-ground, #191f6b);
    transform: translateX(-50%);
  }

  .garden-splash.has-interacted .garden-splash__hint,
  .garden-splash.is-nav-open .garden-splash__hint {
    display: none;
  }

  /* Visitors pick the flower colors: one dot per scheme. */
  .garden-splash__schemes {
    position: absolute;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 4;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }

  .garden-splash.is-nav-open .garden-splash__schemes {
    visibility: hidden;
  }

  .garden-splash__swatch {
    width: 20px;
    height: 20px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--gs-ink, #191f6b);
    border-radius: 50%;
    background: conic-gradient(var(--s1) 0 33%, var(--s2) 0 67%, var(--s3) 0);
    cursor: pointer;
  }

  .garden-splash__swatch[aria-pressed='true'] {
    outline: 1px solid var(--gs-ink, #191f6b);
    outline-offset: 3px;
  }

  .garden-splash__swatch:focus-visible {
    outline: 1px dashed var(--gs-ink, #191f6b);
    outline-offset: 3px;
  }

  /* Menu button: outline, filled plate, plain text, or a custom image. */
  .garden-splash__menu {
    margin: 0;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    pointer-events: auto;
  }

  .garden-splash__menu--outline {
    border-color: currentColor;
  }

  .garden-splash__menu--filled {
    border-color: currentColor;
    background: var(--gs-ground, #191f6b);
  }

  .garden-splash__menu--outline:hover,
  .garden-splash__menu--filled:hover {
    background: var(--gs-ink, #b9e5fb);
    color: var(--gs-ground, #191f6b);
  }

  .garden-splash__menu--text {
    padding: 8px 0;
  }

  .garden-splash__menu--text:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .garden-splash__menu--image {
    padding: 0;
  }

  .garden-splash__menu-img {
    display: block;
    width: var(--gs-menu-image-width, 64px);
    height: auto;
  }

  .garden-splash__menu--image:hover {
    opacity: 0.7;
  }

  .garden-splash__menu:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  /* ---------- Menu ---------- */

  .garden-splash__nav {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 72px max(16px, 8vw);
    background: color-mix(in srgb, var(--gs-ground, #191f6b) 88%, transparent);
    cursor: default;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s linear, visibility 0s linear 0.12s;
  }

  .garden-splash.is-nav-open .garden-splash__nav {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.12s linear;
  }

  .garden-splash__nav-list {
    display: grid;
    gap: 4px;
    width: 100%;
    max-width: 720px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: garden-nav;
  }

  .garden-splash__nav-item {
    counter-increment: garden-nav;
    border-top: 1px solid currentColor;
  }

  .garden-splash__nav-item:last-child {
    border-bottom: 1px solid currentColor;
  }

  .garden-splash__nav-link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 14px 0;
    color: inherit;
    font-size: clamp(20px, 3.2vw, 32px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 2px 0 rgba(240, 78, 98, 0.5), -2px 0 rgba(102, 164, 200, 0.5);
  }

  .garden-splash__nav-item > .garden-splash__nav-link::before {
    content: counter(garden-nav, decimal-leading-zero);
    font-size: 11px;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }

  .garden-splash__nav-link:hover,
  .garden-splash__nav-link:focus-visible {
    color: var(--gs-hero, #f04e62);
    outline: none;
  }

  .garden-splash__nav-sublist {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: -6px 0 12px 40px;
    padding: 0;
    list-style: none;
  }

  .garden-splash__nav-link--sub {
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  @media (max-width: 749px) {
    .garden-splash__hint {
      white-space: normal;
      width: max-content;
      max-width: calc(100% - 32px);
      text-align: center;
      line-height: 1.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-splash__nav {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Garden splash",
  "tag": "section",
  "class": "section--garden-splash",
  "settings": [
    {
      "type": "paragraph",
      "content": "A 3D flower bed on a transparent background, rendered like cheap late-90s CGI, some flowers with eyes that follow the visitor. Every flower grows from seed to full bloom, then the bloomed bed glides into the shape of your logo. Visitors can press and drag to speed up growth, tap to recolor a flower and make the eyes blink, and pick the flower colors. Built to fill the whole screen, so it works best as the only section on a page."
    },
    {
      "type": "header",
      "content": "Logo & menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Leave blank to use Theme settings → Splash streams page → Center logo."
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top center"
        },
        {
          "value": "none",
          "label": "Hidden — the flowers form the logo"
        }
      ],
      "info": "Either way, the flowers arrange themselves into the logo shape below. If the 3D garden can't run, the logo is shown in the center instead."
    },
    {
      "type": "image_picker",
      "id": "flower_logo",
      "label": "Logo shape",
      "info": "Once every flower has bloomed, they arrange themselves into this logo's silhouette. Use a logo with a transparent background. Leave blank to use the Duet wordmark."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Top logo width",
      "min": 40,
      "max": 320,
      "step": 8,
      "unit": "px",
      "default": 120,
      "info": "Used when the logo is shown at the top."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "Opened by the menu button in the top-right corner."
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link",
      "info": "Makes the top logo a link."
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "Menu button style",
      "default": "outline",
      "options": [
        {
          "value": "outline",
          "label": "Outline, no fill"
        },
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "text",
          "label": "Text only"
        },
        {
          "value": "image",
          "label": "Custom image"
        }
      ]
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu button text",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "menu_close_label",
      "label": "Close button text",
      "default": "Close",
      "info": "Shown on the button while the menu is open. Not used with a custom image."
    },
    {
      "type": "image_picker",
      "id": "menu_image",
      "label": "Menu button image",
      "info": "Used with the Custom image style."
    },
    {
      "type": "range",
      "id": "menu_image_width",
      "label": "Menu button image width",
      "min": 24,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "show_schemes",
      "label": "Let visitors change the flower colors",
      "default": true,
      "info": "Shows a row of color dots at the bottom of the screen. The first dot is the colors below."
    },
    {
      "type": "color",
      "id": "center_color",
      "label": "Asterisk flowers",
      "default": "#F04E62"
    },
    {
      "type": "color",
      "id": "center_accent_color",
      "label": "Asterisk accent",
      "default": "#A62749"
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "Garden color 1",
      "default": "#A62749"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Garden color 2",
      "default": "#66A4C8"
    },
    {
      "type": "color",
      "id": "color_3",
      "label": "Garden color 3",
      "default": "#191F6B"
    },
    {
      "type": "color",
      "id": "color_4",
      "label": "Garden color 4",
      "default": "#B9E5FB"
    },
    {
      "type": "color",
      "id": "color_5",
      "label": "Garden color 5",
      "default": "#F04E62"
    },
    {
      "type": "color",
      "id": "color_6",
      "label": "Garden color 6",
      "default": "#B9E5FB"
    },
    {
      "type": "color",
      "id": "foliage_color",
      "label": "Leaves",
      "default": "#66A4C8"
    },
