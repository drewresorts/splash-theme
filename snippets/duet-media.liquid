{%- comment -%}
  A photo or video block among a section's written blocks (sections
  duet-mission, duet-authenticity and duet-story): shown large, edge to
  edge, with no frame, so pictures read apart from the words, with a small
  monospace caption underneath. Styles: assets/component-duet-about.css.

  Accepts:
  - block: a block of type 'photo' or 'video' (settings: image / video,
    video_url, autoplay; caption, link, width, ratio)
  - sizes: the image sizes attribute (optional)

  A video plays one of two ways: an uploaded file (Content → Files), or a
  YouTube or Vimeo link. Set to play on its own, it runs muted and looping,
  like a moving photo (and stays still for visitors who ask for less
  motion); otherwise it shows its controls. An empty block shows a
  placeholder in the theme editor and nothing on the live store.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign kind = block.type
  assign has = false
  if kind == 'photo' and s.image != blank
    assign has = true
  elsif kind == 'video'
    if s.video != blank or s.video_url != blank
      assign has = true
    endif
  endif

  assign ratio = ''
  case s.ratio
    when '16_9'
      assign ratio = '16 / 9'
    when '4_3'
      assign ratio = '4 / 3'
    when '1_1'
      assign ratio = '1 / 1'
    when '3_4'
      assign ratio = '3 / 4'
    else
      if kind == 'photo' and s.image != blank
        assign ratio = s.image.aspect_ratio
      elsif kind == 'video' and s.video != blank
        assign ratio = s.video.aspect_ratio
      else
        assign ratio = '16 / 9'
      endif
  endcase

  assign img_sizes = sizes | default: '(min-width: 1200px) 1120px, 100vw'
-%}
{%- if has or request.design_mode -%}
  <figure class="duet-media duet-media--{{ kind }}">
    <div class="duet-media__frame" style="aspect-ratio: {{ ratio }};">
      {%- if has and kind == 'photo' -%}
        {%- if s.link != blank -%}<a class="duet-media__link" href="{{ s.link }}">{%- endif -%}
        {{
          s.image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '480, 750, 1100, 1500, 2000, 2400',
            sizes: img_sizes,
            class: 'duet-media__img'
        }}
        {%- if s.link != blank -%}</a>{%- endif -%}
      {%- elsif has and s.video != blank -%}
        {%- if s.autoplay -%}
          {{
            s.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false,
              preload: 'metadata',
              image_size: '1600x',
              class: 'duet-media__video duet-media__video--auto'
          }}
        {%- else -%}
          {{ s.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1600x', class: 'duet-media__video' }}
        {%- endif -%}
      {%- elsif has -%}
        {%- liquid
          assign id = s.video_url.id
          if s.video_url.type == 'youtube'
            if s.autoplay
              assign src = 'https://www.youtube-nocookie.com/embed/' | append: id | append: '?autoplay=1&mute=1&loop=1&controls=0&playsinline=1&rel=0&modestbranding=1&playlist=' | append: id
            else
              assign src = 'https://www.youtube-nocookie.com/embed/' | append: id | append: '?rel=0&modestbranding=1&playsinline=1'
            endif
          else
            if s.autoplay
              assign src = 'https://player.vimeo.com/video/' | append: id | append: '?background=1&autoplay=1&muted=1&loop=1'
            else
              assign src = 'https://player.vimeo.com/video/' | append: id | append: '?dnt=1'
            endif
          endif
          assign video_title = s.caption | default: 'Video'
        -%}
        <iframe
          class="duet-media__video"
          src="{{ src }}"
          title="{{ video_title | escape }}"
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
          allowfullscreen
        ></iframe>
      {%- else -%}
        <div class="duet-media__placeholder">
          {%- if kind == 'photo' -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'duet-media__placeholder-svg' }}
            <span>Choose a photo in this block's settings.</span>
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'duet-media__placeholder-svg' }}
            <span>Upload a video, or paste a YouTube or Vimeo link, in this block's settings.</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if s.caption != blank -%}
      <figcaption class="duet-media__caption">{{ s.caption | escape }}</figcaption>
    {%- endif -%}
  </figure>
  {%- if s.autoplay and s.video != blank -%}
    <script>
      // A video set to play on its own stays still for visitors who ask for less motion.
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('video.duet-media__video--auto').forEach(function (v) {
          v.removeAttribute('autoplay');
          v.pause();
          v.controls = true;
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}
