  {
    "name": "Garden motif",
    "settings": [
      {
        "type": "paragraph",
        "content": "Carries the garden splash's 3D flowers through the store: small pre-rendered flowers (one image of about 20KB) on cards, the cart and above the footer, and, optionally, the 3D flower world behind every page."
      },
      {
        "type": "checkbox",
        "id": "garden_motif",
        "label": "Enable garden motif",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "garden_card_bloom",
        "label": "Flower grows on product cards on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "garden_cart_bloom",
        "label": "Flower blooms on the cart icon when something is added",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "garden_empty_cart",
        "label": "Seedling on the empty cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "garden_follow_scheme",
        "label": "Use the flower colors picked on the splash page",
        "default": true,
        "info": "When visitors pick a color on the garden splash, the flowers across the store take that color too."
      },
      {
        "type": "header",
        "content": "Flower world"
      },
      {
        "type": "paragraph",
        "content": "The splash's flowers, formed into the logo, stay behind every other page as a slowly drifting 3D backdrop. A page with its own Garden background section shows that instead. The 3D code loads only after the page itself has loaded."
      },
      {
        "type": "checkbox",
        "id": "garden_world",
        "label": "Show the flower world behind every page",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "soft_navigation",
        "label": "Seamless page changes",
        "default": true,
        "info": "Pages open over the flowers without reloading, so the splash keeps running behind them. The cart, checkout and account pages still open normally. Shopify's own analytics counts only the first page of each visit while this is on."
      },
      {
        "type": "image_picker",
        "id": "garden_world_logo",
        "label": "Logo shape",
        "info": "For visitors who haven't seen the splash yet; once they have, the flowers copy the splash's own look. Use the same image as the garden splash's Logo shape. Leave blank for the Duet wordmark."
      },
      {
        "type": "image_picker",
        "id": "garden_world_logo_mobile",
        "label": "Logo shape on phones",
        "info": "Optional. Used instead on screens narrower than 750px. Use the same image as the garden splash's phone logo shape."
      },
      {
        "type": "select",
        "id": "garden_world_density",
        "label": "Density",
        "default": "overgrown",
        "options": [
          {
            "value": "airy",
            "label": "Airy — larger flowers"
          },
          {
            "value": "lush",
            "label": "Lush"
          },
          {
            "value": "overgrown",
            "label": "Overgrown — smaller, more flowers"
          },
          {
            "value": "packed",
            "label": "Packed — most flowers, the logo filled in solid"
          }
        ],
        "info": "Match the garden splash for the same flowers."
      },
      {
        "type": "range",
        "id": "garden_world_veil",
        "label": "Fade flowers",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "%",
        "default": 30,
        "info": "Washes the page color over the flowers, on top of the frosted glass of each section."
      },
      {
        "type": "select",
        "id": "garden_world_sections",
        "label": "Section backgrounds",
        "default": "translucent",
        "options": [
          {
            "value": "solid",
            "label": "Solid — as designed"
          },
          {
            "value": "translucent",
            "label": "Frosted glass — flowers show softly through"
          },
          {
            "value": "clear",
            "label": "Clear — flowers show fully"
          }
        ],
        "info": "For the sections on each page. The store header and footer stay solid."
      },
      {
        "type": "header",
        "content": "Pollen Dream game"
      },
      {
        "type": "checkbox",
        "id": "garden_game",
        "label": "Enable the Pollen Dream game",
        "default": true,
        "info": "A small first-person game in the 3D garden, opened from the splash and shop menus. Any menu link to /#pollen-dream opens it too. It loads only when a visitor starts it."
      },
      {
        "type": "text",
        "id": "garden_game_label",
        "label": "Menu label",
        "default": "Pollen Dream"
      }
    ]
  }
]
